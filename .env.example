# --- Database ---------------------------------------------------------------
# Runtime (pooled) connection. On Neon use the "-pooler" host with sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/oidc_broker?schema=public"
# Direct (non-pooled) connection used only by `prisma migrate`. On Neon use the
# NON-pooler host. Locally you can set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/oidc_broker?schema=public"

# --- App --------------------------------------------------------------------
# On Vercel set this to your deployment/custom-domain URL, e.g. https://broker.yourdomain.com
PUBLIC_BASE_URL="http://localhost:4010"
ADMIN_API_KEY="change-me"
TENANT_SECRET_ENCRYPTION_KEY="base64-32-bytes-key-here"
SESSION_SIGNING_KEY="base64-32-bytes-key-here"
# Set to "true" on Vercel / any HTTPS host.
COOKIE_SECURE="false"
# Ignored on Vercel (serverless). Only used when running as a normal server.
PORT="4010"

# Optional: Auth0 for broker admin UI (set all three together). In Auth0 → Application → Allowed Callback URLs, add the
# exact URL the broker will send (same scheme, host, port, path). Usually:
#   {PUBLIC_BASE_URL}/admin/auth/auth0/callback
# If that still mismatches (e.g. you open http://127.0.0.1 but PUBLIC_BASE_URL uses localhost), either align PUBLIC_BASE_URL
# with the browser URL or set an explicit callback:
# AUTH0_REDIRECT_URI="http://127.0.0.1:4010/admin/auth/auth0/callback"
# Also add the same origin + "/admin/login" under Application → Allowed Logout URLs (Auth0 redirects there after /v2/logout).
# AUTH0_DOMAIN="your-tenant.eu.auth0.com"
# AUTH0_CLIENT_ID=""
# AUTH0_CLIENT_SECRET=""
# Comma-separated. Entries can be a full email (exact match) or a domain like "@company.com"
# (allows any verified address at that domain).
# ADMIN_AUTH0_ALLOWED_EMAILS="you@company.com,@company.com"
# AUTH0_WORKSPACE_CLAIM="https://backupta.com/workspace"

